@using NailWarehouse.Entities.Models
@using NailWarehouse.EntityExtensions
@using NailWarehouse.Infrastructure
@using NailWarehouse.MvcApp.Models

@model IndexViewModel

@{
    ViewData["Title"] = "Просмотр товаров";
}

<a asp-action="Add" class="btn btn-primary">Добавить</a>
<a asp-action="Index" class="btn btn-light">Обновить</a>

<div class="text-center">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Название</th>
                <th>Размер (мм)</th>
                <th>Материал</th>
                <th>Количество на складе</th>
                <th>Минимальный предел количества</th>
                <th>Цена без НДС (руб.)</th>
                <th>Общая сумма товара (руб.)</th>
                <th colspan="2"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var nail in Model.Nails)
            {
                <tr>
                    <td>@nail.Name</td>
                    <td>@nail.Size</td>
                    <td>@nail.Material.GetDisplayName()</td>
                    <td>@nail.Amount</td>
                    <td>@nail.MinAmount</td>
                    <td>@nail.Price</td>
                    <td>@nail.CalculateTotalPrice()</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@nail.Id" class="btn btn-sm btn-primary">
                            Изменить
                        </a>
                    </td>
                    <td>
                        <button type="button" class="btn btn-sm btn-danger"
                                data-bs-toggle="modal" data-bs-target="#confirm-removal-modal"
                                data-bs-id="@nail.Id">
                            Удалить
                        </button>
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="9">
                    Общее количество товарных позиций: @Model.Statistics.TotalRows |
                    Общая сумма товаров без НДС: @Model.Statistics.TotalPrice.ToString("c") |
                    Общая сумма товаров с НДС @Model.Statistics.Tax.ToString("p0"):
                    @Model.Statistics.TaxedTotalPrice.ToString("c")
                </td>
            </tr>
        </tfoot>
    </table>
</div>

<div class="modal fade" tabindex="-1" id="confirm-removal-modal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Удаление</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Вы уверены?</p>
            </div>
            <div class="modal-footer">
                <form asp-action="Remove" method="post">
                    <input type="hidden" id="id-to-remove" name="id" />
                    <button type="submit" class="btn btn-primary">OK</button>
                </form>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const modal = document.getElementById("confirm-removal-modal");
        if (modal) {
            const input = document.getElementById("id-to-remove");
            modal.addEventListener("show.bs.modal", event => {
                input.value = event.relatedTarget.getAttribute("data-bs-id");
            });
        }
    </script>
}
